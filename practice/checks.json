{
  "schema_version": 1,
  "source_paths": ["orders.py"],
  "fixed_paths": ["test_orders.py", "test_contract_gaps.py", "orders.csv", "PRACTICE.txt", "EXPECTED.json"],
  "checks": [
    {
      "id": "acceptance",
      "kind": "unit",
      "requirements": ["completed-only", "deduplication", "validity", "decimal-rounding"],
      "argv": ["{python}", "-m", "unittest", "-v"],
      "timeout_seconds": 30
    },
    {
      "id": "sample-cli",
      "kind": "local-integration",
      "requirements": ["sample-output", "cli-contract"],
      "argv": ["{python}", "orders.py", "orders.csv"],
      "stdout_json_file": "EXPECTED.json",
      "timeout_seconds": 10
    }
  ]
}
